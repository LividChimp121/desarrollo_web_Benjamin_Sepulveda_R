<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Archivo de configuracion de Maven.
         Aqui se indica que este proyecto usa Spring Boot y que librerias necesita. -->

    <modelVersion>4.0.0</modelVersion>

    <!-- Base de Spring Boot.
         Esto nos evita configurar a mano muchas versiones de librerias. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <!-- Datos generales del proyecto. -->
    <groupId>com.example</groupId>
    <artifactId>tarea4-spring</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>tarea4-spring</name>
    <description>Tarea 4 CC5002</description>

    <!-- Version de Java usada para correr Spring Boot. -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!-- Permite crear rutas web, como /buscar y /api/actividades/buscar.
             Es parecido a usar @app.route en Flask, pero en Spring. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Permite usar JPA: entidades y repositorios.
             Es parecido a SQLAlchemy en Flask, pero para Java/Spring. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Conector para que Java pueda hablar con MySQL. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Permite que Spring muestre templates HTML como buscar.html. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

    </dependencies>

    <!-- Plugin para poder correr la aplicacion con mvn spring-boot:run. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
